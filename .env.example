# App
APP_NAME=BackendDeveloperLanding
APP_OWNER_NAME=Your Name
APP_OWNER_EMAIL=owner@example.com
SECRET_KEY=change-me-to-a-random-string
DEBUG=false

# AI (Agnes AI - OpenAI-compatible)
AI_API_KEY=your-agnes-api-key
AI_API_BASE_URL=https://apihub.agnes-ai.com/v1
AI_MODEL=agnes-2.0-flash

# SMTP (optional - falls back to file log if empty)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Rate limiting
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60
